# CERELO Official Website — Environment Variables
# Copy this file to .env.local and fill in the correct values.
# NEVER commit .env.local to version control.
# NEVER put real credentials in this file.

# ─── Supabase (Public / Client-side) ─────────────────────────────────────────
# Use the Supabase Publishable Key (sb_publishable_...) — safe for browser use.
# Do NOT put the Supabase secret key (sb_secret_...) or legacy service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ─── Release Stage (Indexing Gate) ────────────────────────────────────────────
# Controls robots.txt, HTML robots metadata, and X-Robots-Tag HTTP header.
#
# Values:
#   prelaunch  → noindex / nofollow (default — blocks all crawlers)
#   live       → index / follow     (set ONLY after commercial launch approval)
NEXT_PUBLIC_RELEASE_STAGE=prelaunch

# ─── Environment Label (diagnostics only) ─────────────────────────────────────
# Values: development | staging | production
NEXT_PUBLIC_ENV=development

