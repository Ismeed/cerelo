# Cerelo — Supabase Edge Function Secrets
# Copy to supabase/.env.local for local development.
# NEVER commit .env.local to version control.
# In production, set these via: supabase secrets set KEY=value

# Firebase Cloud Messaging — server-side push notifications only
FCM_SERVER_KEY=your-fcm-server-key-here

# Termii SMS Gateway — Nigerian SMS delivery
TERMII_API_KEY=your-termii-api-key-here
TERMII_SENDER_ID=Cerelo

# JWT signing secret for QR token generation
# Generate with: openssl rand -base64 32
QR_JWT_SECRET=generate-a-strong-random-secret-here

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Allowed CORS origin for Edge Functions (admin web URL)
ALLOWED_ORIGIN=http://localhost:3000

# App environment
APP_ENV=development
